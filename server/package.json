{
  "name": "mini-sudoku-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hint wallet for Mini Sudoku: Google Play receipt verification, Unity S2S reward callback, account deletion. Cloudflare Worker + D1.",
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply mini-sudoku --local",
    "db:migrate:prod": "wrangler d1 migrations apply mini-sudoku --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true,
    "workerd@1.20260903.1": true
  }
}
